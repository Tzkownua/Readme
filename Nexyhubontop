-- 4. ESP SYSTEM (HIGHLIGHT + TRACERS)
-- ============================================================
do
    local _espEnabled = false
    local _espConn = nil
    local _hlCache, _bbCache, _trCache = {}, {}, {}

    local function clearESP()
        for _, hl in pairs(_hlCache) do pcall(function() hl:Destroy() end) end; _hlCache = {}
        for _, bb in pairs(_bbCache) do pcall(function() bb:Destroy() end) end; _bbCache = {}
        for _, lines in pairs(_trCache) do
            for _, ln in ipairs(lines) do pcall(function() ln.Visible = false; ln:Remove() end) end
        end; _trCache = {}
    end

    local function _espUpdate()
        if not _espEnabled then clearESP(); return end
        local cam = workspace.CurrentCamera
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LP and plr.Character then
                local char = plr.Character
                local tRoot = char:FindFirstChild("HumanoidRootPart")
                if tRoot and char:FindFirstChildOfClass("Humanoid") then
                    local hl = _hlCache[plr]
                    if not hl or hl.Parent ~= char then
                        hl = Instance.new("Highlight")
                        hl.Name = "NexyCyanESP"
                        hl.FillColor = CYAN
                        hl.OutlineColor = Color3.fromRGB(255,255,255)
                        hl.FillTransparency = 0.5
                        hl.Adornee = char
                        hl.Parent = char
                        _hlCache[plr] = hl
                    end
                end
            end
        end
    end

    function startESP()
        _espEnabled = true
        if _espConn then _espConn:Disconnect() end
        _espConn = RunService.RenderStepped:Connect(_espUpdate)
    end

    function stopESP()
        _espEnabled = false
        if _espConn then _espConn:Disconnect(); _espConn = nil end
        clearESP()
    end
end

-- ============================================================
-- 5. BAT V2 & DESYNC AIMBOT
-- ============================================================
local batV2Conn = nil
local function startBatV2()
    if batV2Conn then return end
    batV2Conn = RunService.Heartbeat:Connect(function()
        if not batV2Enabled then return end
        local target = getClosestPlayer()
        if target and target.Character then
            local tRoot = target.Character:FindFirstChild("HumanoidRootPart")
            local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            if tRoot and myRoot then
                myRoot.AssemblyLinearVelocity = (tRoot.Position - myRoot.Position).Unit * 55
            end
        end
    end)
end

local function stopBatV2()
    if batV2Conn then batV2Conn:Disconnect(); batV2Conn = nil end
    local root = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if root then root.AssemblyLinearVelocity = Vector3.zero end
end

local _bodyLockConn = nil
local function startBodyLock()
    if _bodyLockConn then _bodyLockConn:Disconnect() end
    _bodyLockConn = RunService.RenderStepped:Connect(function()
        if not bodyLockEnabled then return end
        local target, dist = getClosestPlayer()
        if target and target.Character and dist <= bodyLockRange then
            local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            local tRoot = target.Character:FindFirstChild("HumanoidRootPart")
            if myRoot and tRoot then
                myRoot.CFrame = CFrame.lookAt(myRoot.Position, Vector3.new(tRoot.Position.X, myRoot.Position.Y, tRoot.Position.Z))
            end
        end
    end)
end

local function stopBodyLock()
    if _bodyLockConn then _bodyLockConn:Disconnect(); _bodyLockConn = nil end
end

