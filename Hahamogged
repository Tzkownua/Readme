-- SYSTEME DE SOIN ET ANTI-DIE
--========================================================
local antiDieConfig = {
    healthThreshold = 25,
    healAmount = 100,
    checkInterval = 0.1
}

local isDying = false

local function superHeal(hum)
    pcall(function()
        hum.Health = hum.MaxHealth or 100
    end)
end

local function autoRevive()
    local char = LP.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    
    superHeal(hum)
    hum:ChangeState(Enum.HumanoidStateType.Running)
    
    task.wait(0.05)
    local root = char:FindFirstChild("HumanoidRootPart")
    if root then
        local newPos = root.Position + Vector3.new(0, 3, 0)
        root.CFrame = CFrame.new(newPos)
        root.Velocity = Vector3.zero
    end
    
    task.wait(0.1)
    isDying = false
end

local function setupAntiDie()
    task.spawn(function()
        while task.wait(antiDieConfig.checkInterval) do
            local char = LP.Character
            if char then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then
                    if hum.Health <= 0 then
                        autoRevive()
                    elseif hum.Health <= antiDieConfig.healthThreshold and hum.Health > 0 then
                        superHeal(hum)
                    end
                end
            end
        end
    end)
end

local function monitorHealth()
    local char = LP.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    hum:GetPropertyChangedSignal("Health"):Connect(function()
        if hum.Health <= 0 then
            isDying = true
            superHeal(hum)
            hum:ChangeState(Enum.HumanoidStateType.Running)
            task.wait(0.05)
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then
                local newPos = root.Position + Vector3.new(0, 3, 0)
                root.CFrame = CFrame.new(newPos)
                root.Velocity = Vector3.zero
            end
            task.wait(0.1)
            isDying = false
        end
    end)
end

setupAntiDie()

