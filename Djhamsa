-- Helper: Create Toggle
local function CreateToggle(parentPage, label, defaultVal)
    local Row = Instance.new("Frame")
    Row.Size = UDim2.new(1, 0, 0, 28)
    Row.BackgroundColor3 = colors.InputBg
    Row.Parent = parentPage
    
    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 5)
    Corner.Parent = Row
    
    local LabelText = Instance.new("TextLabel")
    LabelText.Size = UDim2.new(0, 120, 1, 0)
    LabelText.Position = UDim2.new(0, 12, 0, 0)
    LabelText.BackgroundTransparency = 1
    LabelText.Text = label
    LabelText.TextColor3 = colors.TextGray
    LabelText.TextSize = 12
    LabelText.Font = Enum.Font.Gotham
    LabelText.TextXAlignment = Enum.TextXAlignment.Left
    LabelText.Parent = Row
    
    local Switch = Instance.new("Frame")
    Switch.Size = UDim2.new(0, 36, 0, 16)
    Switch.Position = UDim2.new(1, -46, 0.5, -8)
    Switch.BackgroundColor3 = defaultVal and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(60, 60, 60)
    Switch.Parent = Row
    
    local SwitchCorner = Instance.new("UICorner")
    SwitchCorner.CornerRadius = UDim.new(1, 0)
    SwitchCorner.Parent = Switch
    
    local Knob = Instance.new("Frame")
    Knob.Size = UDim2.new(0, 12, 0, 12)
    Knob.Position = defaultVal and UDim2.new(1, -14, 0.5, -6) or UDim2.new(0, 2, 0.5, -6)
    Knob.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
    Knob.Parent = Switch
    
    local KnobCorner = Instance.new("UICorner")
    KnobCorner.CornerRadius = UDim.new(1, 0)
    KnobCorner.Parent = Knob
    
    local isOn = defaultVal
    Switch.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            isOn = not isOn
            Switch.BackgroundColor3 = isOn and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(60, 60, 60)
            Knob.Position = isOn and UDim2.new(1, -14, 0.5, -6) or UDim2.new(0, 2, 0.5, -6)
        end
    end)
end

